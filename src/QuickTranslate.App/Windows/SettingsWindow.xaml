<Window x:Class="QuickTranslate.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QuickTranslate.App.Windows.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Title="QuickTranslate 设置"
        Width="660"
        Height="700"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, sans-serif"
        FontSize="13"
        Foreground="#1D1D1F"
        Opacity="0"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- 颜色资源（macOS 风格色板） -->
        <SolidColorBrush x:Key="BgAccent" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E8E8ED"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1D1D1F"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6E6E73"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#86868B"/>
        <SolidColorBrush x:Key="Brand600" Color="#007AFF"/>
        <SolidColorBrush x:Key="Brand700" Color="#0066D6"/>
        <SolidColorBrush x:Key="Brand50" Color="#EAF3FF"/>
        <SolidColorBrush x:Key="Success" Color="#1F9D55"/>
        <SolidColorBrush x:Key="Warning" Color="#D97706"/>
        <SolidColorBrush x:Key="Danger" Color="#FF3B30"/>
        <SolidColorBrush x:Key="SuccessBg" Color="#EAF9EF"/>
        <SolidColorBrush x:Key="WarningBg" Color="#FFF8EB"/>
        <SolidColorBrush x:Key="DangerBg" Color="#FFEBEA"/>

        <!-- Section 卡片 -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18 16"/>
            <Setter Property="Margin" Value="0 0 0 14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#3A3A3C" Opacity="0.05" BlurRadius="12" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section 图标容器 -->
        <Style x:Key="SectionIcon" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Margin" Value="0 0 10 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 复选框：macOS 圆角方块 + 品牌色填充 -->
        <Style x:Key="CompactCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Border x:Name="Box" CornerRadius="5"
                                        Background="#FFFFFF"
                                        BorderBrush="#C9C9CE"
                                        BorderThickness="1.5"/>
                                <Path x:Name="Check"
                                      Data="M 3.8,9.2 L 7.3,12.6 L 14.2,5.4"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="8 0 0 0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 选中：底/边渐变为品牌色；勾号为可见性瞬切（不适合渐变） -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Box"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#007AFF" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Box"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#007AFF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Box"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#FFFFFF" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Box"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#C9C9CE" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- 悬停描边仅在未选中时生效：选中态边框已是品牌色，
                                 加 IsChecked 守卫避免退出悬停把选中边框错误还原成灰 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Box"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#007AFF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Box"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#C9C9CE" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置标签 -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 8 0"/>
        </Style>

        <!-- 次级描述 -->
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0 2 0 0"/>
        </Style>

        <!-- 主要按钮：保存（药丸形） -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brand600}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22 7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- hover/press 背景以 120ms 渐变过渡；press 退出回到 hover 色 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#0A84FF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#007AFF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#0066D6" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#0A84FF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- 禁用是持续状态，瞬切即可 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Background" Value="#B3D7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮：取消 -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#D2D2D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22 7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- hover/press 背景以 120ms 渐变过渡；press 退出回到 hover 色而非默认白 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#F5F5F7" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#FFFFFF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#EBEBEF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#F5F5F7" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 幽灵按钮：恢复默认 -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14 6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 背景以 120ms 渐变；前景色为共享资源画刷不做动画，保持瞬切 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#E8E8ED" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="Transparent" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框通用 -->
        <Style x:Key="StyledTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10 6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D2D2D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 悬停描边仅在未聚焦时生效，避免退出悬停把聚焦边框错误还原成灰 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsKeyboardFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#AEAEB2" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#D2D2D7" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <!-- 聚焦：品牌色描边渐变 + 边框厚度平滑加粗到 1.5 -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#007AFF" Duration="0:0:0.12"/>
                                            <ThicknessAnimation Storyboard.TargetName="B"
                                                                 Storyboard.TargetProperty="BorderThickness"
                                                                 To="1.5" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#D2D2D7" Duration="0:0:0.12"/>
                                            <ThicknessAnimation Storyboard.TargetName="B"
                                                                 Storyboard.TargetProperty="BorderThickness"
                                                                 To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyledPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10 6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D2D2D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="B" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 悬停描边仅在未聚焦时生效，避免退出悬停把聚焦边框错误还原成灰 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsKeyboardFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#AEAEB2" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#D2D2D7" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <!-- 聚焦：品牌色描边渐变 + 边框厚度平滑加粗到 1.5 -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#007AFF" Duration="0:0:0.12"/>
                                            <ThicknessAnimation Storyboard.TargetName="B"
                                                                 Storyboard.TargetProperty="BorderThickness"
                                                                 To="1.5" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#D2D2D7" Duration="0:0:0.12"/>
                                            <ThicknessAnimation Storyboard.TargetName="B"
                                                                 Storyboard.TargetProperty="BorderThickness"
                                                                 To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框箭头按钮 -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" CornerRadius="7"
                                Background="#FFFFFF"
                                BorderBrush="#D2D2D7"
                                BorderThickness="1">
                            <Path x:Name="Arrow"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0 0 10 0"
                                  Data="M 0,0 L 4.5,4.5 L 9,0"
                                  Stroke="#8E8E93" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 悬停描边仅在未展开时生效，避免退出悬停把展开态边框错误还原成灰 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#AEAEB2" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#D2D2D7" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#007AFF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#D2D2D7" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyledComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="B" CornerRadius="6" Margin="4 1" Padding="10 6"
                                            Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="{StaticResource Brand600}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Style="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Margin="10 0 30 0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="280"
                                        Margin="8"
                                        Background="#FFFFFF"
                                        CornerRadius="9"
                                        BorderBrush="#E5E5EA"
                                        BorderThickness="1"
                                        Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1D1D1F" Opacity="0.14" BlurRadius="18" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio Button：macOS 圆点样式 -->
        <Style x:Key="QualityRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0 0 18 0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Fill="White" Stroke="#C9C9CE" StrokeThickness="1.5"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8"
                                         Fill="{StaticResource Brand600}"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="7 0 0 0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 选中：圆环渐变为品牌色；圆点为可见性瞬切 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Ring"
                                                            Storyboard.TargetProperty="(Ellipse.Stroke).(SolidColorBrush.Color)"
                                                            To="#007AFF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Ring"
                                                            Storyboard.TargetProperty="(Ellipse.Stroke).(SolidColorBrush.Color)"
                                                            To="#C9C9CE" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- 悬停描边仅在未选中时生效，避免退出悬停把选中描边错误还原成灰 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Ring"
                                                            Storyboard.TargetProperty="(Ellipse.Stroke).(SolidColorBrush.Color)"
                                                            To="#007AFF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Ring"
                                                            Storyboard.TargetProperty="(Ellipse.Stroke).(SolidColorBrush.Color)"
                                                            To="#C9C9CE" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态行 -->
        <Style x:Key="StatusRow" TargetType="Grid">
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- 标题行 -->
        <Style x:Key="SectionTitleRow" TargetType="Grid">
            <Setter Property="Margin" Value="0 0 0 12"/>
        </Style>

        <!-- 标题栏关闭按钮（Windows 风格，悬停变红） -->
        <Style x:Key="CaptionCloseButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="0 11 0 0">
                            <Path x:Name="Icon"
                                  Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="{StaticResource TextSecondary}"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 背景以 120ms 渐变（透明→红）；图标描边为共享资源画刷保持瞬切 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Icon" Property="Stroke" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#E81123" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="Transparent" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Icon" Property="Stroke" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#F1707A" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="B"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#E81123" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 根容器：承载内容 + Toast 覆盖 -->
    <Grid>
        <!-- 圆角卡片主体 -->
        <Border x:Name="RootBorder"
                Background="{StaticResource BgAccent}"
                CornerRadius="12"
                BorderBrush="#E0E0E5"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.22" BlurRadius="22" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>   <!-- 标题栏 -->
                    <RowDefinition Height="*"/>    <!-- 滚动内容 -->
                    <RowDefinition Height="Auto"/> <!-- 错误提示 -->
                    <RowDefinition Height="Auto"/> <!-- 底部操作栏 -->
                </Grid.RowDefinitions>

                <!-- 标题栏（可拖拽） -->
                <Grid Grid.Row="0" MouseLeftButtonDown="OnTitleBarDragMove">
                    <Border BorderBrush="#E8E8ED" BorderThickness="0 0 0 1"/>
                    <TextBlock Text="QuickTranslate 设置"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CaptionCloseButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Click="OnCloseClicked"/>
                </Grid>

                <!-- 滚动内容区 -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20 16 16 8"
                              x:Name="ContentScroll">
                    <StackPanel>

                        <!-- STATUS STRIP — 紧凑单页方案 B 顶部状态条 -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10,16,11" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect Color="#3A3A3C" Opacity="0.05" BlurRadius="12" ShadowDepth="1"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="OCR 引擎" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OcrEngineName" Text="检测中..." FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <Border x:Name="OcrEngineBadge" CornerRadius="10" Padding="10,3" Background="{StaticResource WarningBg}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="OcrEngineStatus" Text="未知" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
                                    </Border>
                                </StackPanel>
                                <Border Width="1" Background="#E8E8ED" Margin="14,2" Height="16" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="热键注册" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HotkeyStatusText" Text="单词: Alt+1  区域: Alt+2" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <Border x:Name="HotkeyBadge" CornerRadius="10" Padding="10,3" Background="{StaticResource SuccessBg}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="已生效" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                                    </Border>
                                </StackPanel>
                                <Border Width="1" Background="#E8E8ED" Margin="14,2" Height="16" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="程序版本" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AppVersionText" Text="v0.1.0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- S1: 翻译服务 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Style="{StaticResource SectionTitleRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SectionIcon}" Background="#E7F1FF">
                                        <!-- Segoe Fluent Icons 锁（E72E，对应 API Key 安全） -->
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#007AFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="翻译服务"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0 0 0 10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="翻译引擎"
                                               Style="{StaticResource SettingLabel}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              x:Name="TranslationProviderBox"
                                              Style="{StaticResource StyledComboBox}"
                                              SelectionChanged="OnTranslationProviderChanged">
                                        <ComboBoxItem Content="自定义大模型（OpenAI 兼容 · 推荐）" Tag="CustomOpenAi"/>
                                        <ComboBoxItem Content="Qwen-MT（阿里 DashScope）" Tag="QwenMt"/>
                                    </ComboBox>
                                </Grid>

                                <!-- 自定义大模型配置 -->
                                <StackPanel x:Name="CustomLlmPanel">
                                    <Grid Margin="0 0 0 8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="API 地址"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox Grid.Column="1"
                                                 x:Name="CustomLlmBaseUrlBox"
                                                 Style="{StaticResource StyledTextBox}"
                                                 Margin="0 0 0 2"/>
                                    </Grid>
                                    <TextBlock Text="OpenAI 兼容端点，自动补全 /chat/completions"
                                               ToolTip="OpenAI 兼容端点，例如 https://api.openai.com/v1、https://api.deepseek.com/v1 或本地 http://127.0.0.1:11434/v1（Ollama）。自动补全 /chat/completions。"
                                               Style="{StaticResource SettingHint}"
                                               Margin="96 0 0 8"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="16"/>

                                    <Grid Margin="0 0 0 8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="模型名称"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox Grid.Column="1"
                                                 x:Name="CustomLlmModelBox"
                                                 Style="{StaticResource StyledTextBox}"
                                                 Margin="0 0 0 2"/>
                                    </Grid>
                                    <TextBlock Text="支持任意 OpenAI 兼容服务"
                                               ToolTip="例如 gpt-4o-mini、deepseek-chat、qwen2.5:7b。支持任何 OpenAI 兼容服务（vLLM / Ollama / one-api / 各云厂商）。"
                                               Style="{StaticResource SettingHint}"
                                               Margin="96 0 0 10"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="16"/>

                                    <!-- 模型连通性测试 -->
                                    <Grid Margin="0 0 0 6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="1"
                                                x:Name="TestModelButton"
                                                Content="测试连接"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="14 5"
                                                FontSize="12"/>
                                        <TextBlock Grid.Column="2"
                                                   x:Name="ModelTestStatus"
                                                   Text="用当前填写的配置发一次探测请求，验证模型是否可用"
                                                   Style="{StaticResource SettingHint}"
                                                   Margin="10 0 0 0"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="0 0 0 8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="API Key"
                                               Style="{StaticResource SettingLabel}"/>
                                    <PasswordBox Grid.Column="1"
                                                 x:Name="ApiKeyBox"
                                                 PasswordChar="*"
                                                 Style="{StaticResource StyledPasswordBox}"
                                                 Margin="0 0 10 0"/>
                                    <Border Grid.Column="2"
                                            x:Name="ApiKeyStatusBadge"
                                            CornerRadius="10"
                                            Padding="10 3"
                                            Background="{StaticResource SuccessBg}"
                                            Margin="0 0 8 0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="ApiKeyStatusText"
                                                   Text="未填"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </Border>
                                    <Button Grid.Column="3"
                                            x:Name="ClearApiKeyButton"
                                            Content="清除"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="14 5"
                                            FontSize="12"/>
                                </Grid>
                                <TextBlock Text="DPAPI 加密存储，绝不明文落盘"
                                           ToolTip="自定义大模型：填 OpenAI 兼容服务的 Key（本地 Ollama 可填任意非空值）；Qwen-MT：DashScope 控制台 → API-KEY 管理。留空则使用内置演示翻译（占位结果）。"
                                           Style="{StaticResource SettingHint}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="16"/>
                            </StackPanel>
                        </Border>

                        <!-- S2: 翻译与显示（合并原 翻译偏好 + 行为设置） -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Style="{StaticResource SectionTitleRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SectionIcon}" Background="#E6F7EE">
                                        <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#34C759" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="翻译与显示"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0 0 0 12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="目标语言"
                                               Style="{StaticResource SettingLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              x:Name="TargetLanguageBox"
                                              Style="{StaticResource StyledComboBox}">
                                        <ComboBoxItem Content="中文简体 (zh-CN)" Tag="zh-CN"/>
                                        <ComboBoxItem Content="英语 (en-US)" Tag="en"/>
                                        <ComboBoxItem Content="日语 (ja-JP)" Tag="ja"/>
                                        <ComboBoxItem Content="韩语 (ko-KR)" Tag="ko"/>
                                        <ComboBoxItem Content="德语 (de-DE)" Tag="de"/>
                                        <ComboBoxItem Content="法语 (fr-FR)" Tag="fr"/>
                                        <ComboBoxItem Content="西班牙语 (es-ES)" Tag="es"/>
                                        <ComboBoxItem Content="俄语 (ru-RU)" Tag="ru"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0 0 0 12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="翻译质量"
                                               Style="{StaticResource SettingLabel}"
                                               VerticalAlignment="Top"
                                               Margin="0 4 0 0"/>
                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="QualityFast"
                                                         Content="Fast · 速度优先"
                                                         GroupName="Quality"
                                                         Style="{StaticResource QualityRadio}"
                                                         Tag="Fast"/>
                                            <RadioButton x:Name="QualityBalanced"
                                                         Content="Balanced · 均衡"
                                                         GroupName="Quality"
                                                         Style="{StaticResource QualityRadio}"
                                                         Tag="Balanced"/>
                                            <RadioButton x:Name="QualityBest"
                                                         Content="Best · 最佳质量"
                                                         GroupName="Quality"
                                                         Style="{StaticResource QualityRadio}"
                                                         Tag="Best"/>
                                        </StackPanel>
                                        <TextBlock Text="Fast 响应最快、用量少；Best 输出更准确但稍慢。Balanced 取折中。"
                                                   ToolTip="Fast 响应最快、用量少；Best 输出更准确但稍慢。Balanced 取折中。"
                                                   Style="{StaticResource SettingHint}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="16"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0 0 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="弹窗显示样式"
                                               Style="{StaticResource SettingLabel}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              x:Name="PopupDisplayStyleBox"
                                              Style="{StaticResource StyledComboBox}">
                                        <ComboBoxItem Content="简洁" Tag="compact"/>
                                        <ComboBoxItem Content="详细" Tag="detailed"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="简洁隐藏元信息并使用图标按钮"
                                           ToolTip="详细显示来源标签与文字按钮，简洁隐藏元信息并使用图标按钮；下次弹窗生效。"
                                           Style="{StaticResource SettingHint}"
                                           Margin="96 4 0 12"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="16"/>

                                <TextBlock Text="选项"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13"
                                           Margin="0,2,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <CheckBox x:Name="StartOnBootBox"
                                                  Content="开机启动"
                                                  Style="{StaticResource CompactCheckBox}"/>
                                        <CheckBox x:Name="CloseOutsideBox"
                                                  Content="点击外部自动关闭弹窗"
                                                  Style="{StaticResource CompactCheckBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="EnableReadAloudBox"
                                                  Content="启用朗读"
                                                  Style="{StaticResource CompactCheckBox}"/>
                                        <CheckBox x:Name="DebugLoggingBox"
                                                  Content="Debug 日志"
                                                  Style="{StaticResource CompactCheckBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- S3: 性能加速 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Style="{StaticResource SectionTitleRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SectionIcon}" Background="#FFF4E5">
                                        <TextBlock Text="&#xE9F3;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF9500" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="性能"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <CheckBox x:Name="HardwareAccelerationCheckBox"
                                          Content="核显加速 (AMD/Intel DirectML)"
                                          Style="{StaticResource CompactCheckBox}"
                                          ToolTip="AMD / Intel 核显通用（DML device_id=0）。开启后 OCR 将尝试使用核显加速，失败自动回退 CPU；关闭则强制 CPU 推理。"/>
                                <TextBlock Text="开启后 OCR 将尝试使用核显加速，关闭则强制 CPU；需要重启或下一次 OCR 生效。失败自动回退 CPU，无需手动切换。"
                                           Style="{StaticResource SettingHint}"
                                           Margin="26 0 0 2"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- S4: 全局热键 -->
                        <Border Style="{StaticResource SectionCard}" Margin="0 0 0 0">
                            <StackPanel>
                                <Grid Style="{StaticResource SectionTitleRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SectionIcon}" Background="#F3EDFF">
                                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#7C5CE0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="全局热键"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Word 热键行 -->
                                <Grid Margin="0 0 0 10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="单词翻译"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Alt + 1（默认）"
                                                   Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <controls:HotkeyRecorder Grid.Column="1"
                                                             x:Name="WordHotkeyRecorder"
                                                             VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Block 热键行 -->
                                <Grid Margin="0 0 0 4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="区域句子翻译"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Alt + 2（默认）"
                                                   Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <controls:HotkeyRecorder Grid.Column="1"
                                                             x:Name="BlockHotkeyRecorder"
                                                             VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="按「录制」后直接按下新热键组合，松开即保存"
                                           ToolTip="提示：按「录制」后直接在键盘按下新的热键组合，松开即保存到输入框。"
                                           Style="{StaticResource SettingHint}"
                                           Margin="0 8 0 0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="16"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 错误提示条 -->
                <Border Grid.Row="2"
                        x:Name="ErrorBorder"
                        CornerRadius="8"
                        Background="{StaticResource DangerBg}"
                        Padding="12 8"
                        Margin="20 0 20 8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorLabel"
                               Foreground="{StaticResource Danger}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- 底部操作栏 -->
                <Border Grid.Row="3"
                        BorderBrush="#E8E8ED"
                        BorderThickness="0 1 0 0"
                        Padding="20 12">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                x:Name="RestoreDefaultsButton"
                                Content="恢复默认设置"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left"/>
                        <Button Grid.Column="1"
                                x:Name="CancelButton"
                                Content="取消"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0 0 10 0"/>
                        <Button Grid.Column="2"
                                x:Name="SaveButton"
                                Content="保存设置"
                                Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Toast 覆盖层（悬浮于内容之上，底部居中） -->
        <Border x:Name="ToastBorder"
                Background="#1D1D1F"
                CornerRadius="11"
                Padding="20 12"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0 0 0 84"
                Visibility="Collapsed"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect Opacity="0.28" BlurRadius="18" ShadowDepth="0"/>
            </Border.Effect>
            <TextBlock x:Name="ToastText"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"/>
        </Border>
    </Grid>
</Window>
