<Window x:Class="QuickTranslate.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QuickTranslate.App.Windows.Controls"
        ShowInTaskbar="False"
        ResizeMode="CanMinimize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Title="Settings"
        Width="520"
        Height="560"
        Background="#FFFDFDFD">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0 0 0 16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Settings"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>
                <Button Grid.Column="1"
                        x:Name="CloseButton"
                        Content="×"
                        FontSize="20"
                        FontWeight="Bold"
                        Padding="8 0"
                        Width="36"
                        Height="32"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#6B7280"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0 0 0 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="API Key"
                           VerticalAlignment="Center"
                           Foreground="#374151"/>
                <PasswordBox Grid.Column="1"
                             x:Name="ApiKeyBox"
                             PasswordChar="*"
                             VerticalContentAlignment="Center"
                             Padding="6 4"
                             Margin="0 0 8 0"/>
                <Button Grid.Column="2"
                        x:Name="ClearApiKeyButton"
                        Content="清除"
                        Padding="10 4"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0 0 0 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Word Hotkey"
                           VerticalAlignment="Center"
                           Foreground="#374151"/>
                <controls:HotkeyRecorder Grid.Column="1"
                                         x:Name="WordHotkeyRecorder"
                                         VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0 0 0 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Block Hotkey"
                           VerticalAlignment="Center"
                           Foreground="#374151"/>
                <controls:HotkeyRecorder Grid.Column="1"
                                         x:Name="BlockHotkeyRecorder"
                                         VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="4" Margin="0 0 0 12">
                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="目标语言"
                               VerticalAlignment="Center"
                               Foreground="#374151"/>
                    <ComboBox Grid.Column="1"
                              x:Name="TargetLanguageBox"
                              VerticalContentAlignment="Center"
                              Margin="0 0 12 0">
                        <ComboBoxItem Content="中文 (zh-CN)" Tag="zh-CN"/>
                        <ComboBoxItem Content="英语 (en)" Tag="en"/>
                        <ComboBoxItem Content="日语 (ja)" Tag="ja"/>
                        <ComboBoxItem Content="韩语 (ko)" Tag="ko"/>
                        <ComboBoxItem Content="德语 (de)" Tag="de"/>
                        <ComboBoxItem Content="法语 (fr)" Tag="fr"/>
                        <ComboBoxItem Content="西班牙语 (es)" Tag="es"/>
                        <ComboBoxItem Content="俄语 (ru)" Tag="ru"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2"
                               Text="翻译质量"
                               VerticalAlignment="Center"
                               Foreground="#374151"/>
                    <ComboBox Grid.Column="3"
                              x:Name="TranslationQualityBox"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Fast" Tag="Fast"/>
                        <ComboBoxItem Content="Balanced" Tag="Balanced"/>
                        <ComboBoxItem Content="Best" Tag="Best"/>
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="StartOnBootBox"
                          Content="开机启动"
                          Margin="100 0 0 6"
                          Foreground="#374151"/>
                <CheckBox x:Name="CloseOutsideBox"
                          Content="点击外部关闭 Popup"
                          Margin="100 0 0 6"
                          Foreground="#374151"/>
                <CheckBox x:Name="DebugLoggingBox"
                          Content="Debug 日志"
                          Margin="100 0 0 0"
                          Foreground="#374151"/>
            </StackPanel>

            <TextBlock Grid.Row="5"
                       x:Name="ErrorLabel"
                       Foreground="#DC2626"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0 0 0 8"/>

            <Grid Grid.Row="6" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        x:Name="SaveButton"
                        Content="保存"
                        Padding="18 6"
                        Margin="0 0 8 0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderBrush="Transparent"/>
                <Button Grid.Column="2"
                        x:Name="CancelButton"
                        Content="取消"
                        Padding="18 6"/>
            </Grid>
        </Grid>
    </Border>
</Window>
