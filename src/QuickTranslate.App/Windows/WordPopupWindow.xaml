<Window x:Class="QuickTranslate.App.Windows.WordPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Title="QuickTranslate Popup"
        Width="320"
        MinHeight="120"
        Left="0"
        Top="0">
    <Border x:Name="RootBorder"
            Background="#FFFDFDFD"
            CornerRadius="10"
            Padding="14"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.15"
                              Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock x:Name="WordHeader"
                           FontWeight="Bold"
                           FontSize="18"
                           Foreground="#1F2937"
                           Margin="0 0 12 0"
                           Text=""/>
                <TextBlock x:Name="DictionaryBadge"
                           Text="Dictionary"
                           Foreground="#16A34A"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Visibility="Hidden"/>
                <TextBlock x:Name="CacheBadge"
                           Text="Cache"
                           Foreground="#2563EB"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="8 0 0 0"
                           Visibility="Hidden"/>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       x:Name="TranslationText"
                       FontSize="14"
                       Foreground="#111827"
                       TextWrapping="Wrap"
                       Margin="0 8 0 8"
                       Text=""/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CopyButton"
                        Content="复制"
                        Padding="10 4"
                        Margin="6 0 0 0"/>
                <Button x:Name="DismissButton"
                        Content="关闭"
                        Padding="10 4"
                        Margin="6 0 0 0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
