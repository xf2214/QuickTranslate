<Window x:Class="QuickTranslate.App.Windows.WordPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Title="QuickTranslate Popup"
        Width="280"
        MinHeight="110"
        Left="0"
        Top="0">
    <!-- 自包含按钮样式：测试会脱离 App 资源直接实例化本窗口 -->
    <Window.Resources>
        <ResourceDictionary Source="/QuickTranslate.App;component/Themes/Generic.xaml"/>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="#F8FFFFFF"
            BorderBrush="#1A000000"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True"
            TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="3"
                              Opacity="0.18"
                              Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 选中文本可能是一整句（选词最多 15 词）：标题可换行最多 3 行再省略，
                 徽标停靠右侧不被长标题挤出；短单词时视觉效果与原来一致 -->
            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="8 3 0 0">
                    <Border x:Name="DictionaryBadge"
                            Background="#E8F8EE"
                            CornerRadius="8"
                            Padding="7 2"
                            VerticalAlignment="Center"
                            Visibility="Hidden">
                        <TextBlock Text="词典"
                                   Foreground="#34C759"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="CacheBadge"
                            Background="#EAF3FF"
                            CornerRadius="8"
                            Padding="7 2"
                            Margin="6 0 0 0"
                            VerticalAlignment="Center"
                            Visibility="Hidden">
                        <TextBlock Text="缓存"
                                   Foreground="#007AFF"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="WordHeader"
                           FontWeight="Bold"
                           FontSize="18"
                           Foreground="#1C1C1E"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="76"
                           Text=""/>
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="300"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="TranslationText"
                           FontSize="14"
                           Foreground="#1C1C1E"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           Margin="0 8 0 10"
                           Text=""/>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="SpeakButton"
                        Style="{StaticResource PopupActionButton}"
                        Padding="12 5"
                        Margin="8 0 0 0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <!-- Segoe Fluent Icons 音量图标（单色线性，与全局极简风格一致，替代 emoji） -->
                        <TextBlock Text="&#xE767;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0 1 5 0"/>
                        <TextBlock Text="朗读" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton"
                        Content="复制"
                        Style="{StaticResource PopupActionButton}"
                        Padding="12 5"
                        Margin="8 0 0 0"/>
                <Button x:Name="DismissButton"
                        Content="关闭"
                        Style="{StaticResource PopupDismissButton}"
                        Padding="12 5"
                        Margin="8 0 0 0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
