<Window x:Class="QuickTranslate.App.Windows.WordPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Title="QuickTranslate Popup"
        Width="320"
        MinHeight="120"
        Left="0"
        Top="0">
    <!-- 自包含按钮样式：测试会脱离 App 资源直接实例化本窗口 -->
    <Window.Resources>
        <ResourceDictionary Source="/QuickTranslate.App;component/Themes/Generic.xaml"/>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="#F8FFFFFF"
            BorderBrush="#1A000000"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
            SnapsToDevicePixels="True"
            TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="4"
                              Opacity="0.16"
                              Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock x:Name="WordHeader"
                           FontWeight="Bold"
                           FontSize="18"
                           Foreground="#1C1C1E"
                           Margin="0 0 10 0"
                           Text=""/>
                <Border x:Name="DictionaryBadge"
                        Background="#E8F8EE"
                        CornerRadius="8"
                        Padding="7 2"
                        VerticalAlignment="Center"
                        Visibility="Hidden">
                    <TextBlock Text="词典"
                               Foreground="#34C759"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="CacheBadge"
                        Background="#EAF3FF"
                        CornerRadius="8"
                        Padding="7 2"
                        Margin="6 0 0 0"
                        VerticalAlignment="Center"
                        Visibility="Hidden">
                    <TextBlock Text="缓存"
                               Foreground="#007AFF"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="300"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="TranslationText"
                           FontSize="14"
                           Foreground="#1C1C1E"
                           TextWrapping="Wrap"
                           Margin="0 8 0 8"
                           Text=""/>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="SpeakButton"
                        Content="🔊 朗读"
                        Style="{StaticResource PopupActionButton}"
                        Padding="12 5"
                        Margin="8 0 0 0"
                        Visibility="Collapsed"/>
                <Button x:Name="CopyButton"
                        Content="复制"
                        Style="{StaticResource PopupActionButton}"
                        Padding="12 5"
                        Margin="8 0 0 0"/>
                <Button x:Name="DismissButton"
                        Content="关闭"
                        Style="{StaticResource PopupDismissButton}"
                        Padding="12 5"
                        Margin="8 0 0 0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
