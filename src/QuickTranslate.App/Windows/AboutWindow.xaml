<Window x:Class="QuickTranslate.App.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Title="关于 QuickTranslate"
        Width="420"
        Height="360">
    <!-- 自包含按钮样式：使窗口可脱离 App 资源独立实例化 -->
    <Window.Resources>
        <ResourceDictionary Source="/QuickTranslate.App;component/Themes/Generic.xaml"/>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="#FFFDFDFD"
            CornerRadius="12"
            Padding="20"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.18"
                              Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0 0 0 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="QT"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#2563EB"
                           Margin="0 0 14 0"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="QuickTranslate"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#111827"
                           VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="4 0">
                <TextBlock x:Name="VersionLabel"
                           FontSize="13"
                           Foreground="#374151"
                           Margin="0 0 0 6"/>
                <TextBlock x:Name="BuildLabel"
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="0 0 0 6"/>
                <TextBlock x:Name="CopyrightLabel"
                           FontSize="12"
                           Foreground="#6B7280"/>
                <!-- 模型/翻译能力说明（与 docs/ocr-models-and-custom-llm.md 保持同步） -->
                <TextBlock x:Name="OcrInfoLabel"
                           Text="OCR：PP-OCRv6 medium（ONNX Runtime，源 HoVDuc/ppocrv5-onnx）· 字典 18708 字符"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           TextWrapping="Wrap"
                           Margin="0 10 0 0"/>
                <TextBlock x:Name="TranslationInfoLabel"
                           Text="翻译：支持任意 OpenAI 兼容大模型端点（设置 → 翻译引擎），亦可用内置 Qwen-MT"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           TextWrapping="Wrap"
                           Margin="0 4 0 0"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0 12 0 0">
                <Button x:Name="CheckModelButton"
                        Content="检查模型"
                        Style="{StaticResource PopupActionButton}"
                        Padding="12 5"
                        Margin="0 0 8 0"/>
                <Button x:Name="LicenseButton"
                        Content="许可证"
                        Style="{StaticResource PopupActionButton}"
                        Padding="12 5"
                        Margin="0 0 8 0"/>
                <Button x:Name="CloseButton"
                        Content="关闭"
                        Style="{StaticResource PopupDismissButton}"
                        Padding="12 5"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
