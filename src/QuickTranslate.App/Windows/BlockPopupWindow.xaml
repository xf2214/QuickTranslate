<Window x:Class="QuickTranslate.App.Windows.BlockPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Title="QuickTranslate Block Popup"
        Width="340"
        MinHeight="110"
        MaxHeight="600"
        Left="0"
        Top="0">
    <!-- 自包含按钮样式：测试会脱离 App 资源直接实例化本窗口 -->
    <Window.Resources>
        <ResourceDictionary Source="/QuickTranslate.App;component/Themes/Generic.xaml"/>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="#F8FFFFFF"
            BorderBrush="#1A000000"
            BorderThickness="1"
            CornerRadius="12"
            Padding="11"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True"
            TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="3"
                              Opacity="0.18"
                              Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: 元信息行（详细模式可见） -->
                <RowDefinition Height="Auto"/>
                <!-- 1: 译文（Hero） -->
                <RowDefinition Height="*"/>
                <!-- 2: 源文区（ToggleRow + Quote + divider） -->
                <RowDefinition Height="Auto"/>
                <!-- 3: 页脚 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 详细模式元信息行：● 翻译中… / ● 完成 / ● 翻译失败 -->
            <StackPanel x:Name="MetaRow" Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 6" Visibility="Collapsed">
                <Ellipse x:Name="MetaDot" Width="6" Height="6" Fill="#007AFF" VerticalAlignment="Center" Margin="0 0 6 0"/>
                <TextBlock x:Name="MetaText" FontSize="11.5" FontWeight="Medium" Foreground="#6D6D72" Text="翻译中…" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 译文 ScrollViewer：Compact 15/25  Detailed 14.5/24 通过代码切换 -->
            <ScrollViewer Grid.Row="1"
                          x:Name="ScrollViewer1"
                          MaxHeight="460"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TranslationText"
                           FontSize="15"
                           Foreground="#1C1C1E"
                           LineHeight="25"
                           TextWrapping="Wrap"
                           Text=""/>
            </ScrollViewer>

            <!-- 源文区：ToggleRow + Quote Border + hairline divider -->
            <StackPanel Grid.Row="2" x:Name="SourceSection" Margin="0 6 0 0">
                <!-- 折叠/展开触发行：Compact 显示“原文 (N 行)”，Detailed 作为右侧 chevron 触发 -->
                <StackPanel x:Name="ToggleRow"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            Background="Transparent">
                    <TextBlock x:Name="ToggleChevron"
                               Text="&#xE76C;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="#8E8E93"
                               VerticalAlignment="Center"
                               Margin="0 0 4 0"/>
                    <TextBlock x:Name="ToggleLabel"
                               FontSize="12"
                               Foreground="#8E8E93"
                               Text="原文 (0 行)"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 浅灰引用块：#F5F5F7 CornerRadius8 Padding11,8 -->
                <Border x:Name="SourceQuote"
                        Background="#F5F5F7"
                        CornerRadius="8"
                        Padding="11,8"
                        Margin="0 4 0 0"
                        Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="SourceText"
                                   FontSize="12"
                                   Foreground="#6D6D72"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   MaxHeight="54"
                                   TextTrimming="CharacterEllipsis"
                                   Text=""/>
                        <!-- 详细模式右下角展开指示（点击展开到 120） -->
                        <TextBlock x:Name="SourceExpandChevron"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Text="&#xE76C;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="9"
                                   Foreground="#8E8E93"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <!-- hairline divider -->
                <Rectangle x:Name="SourceDivider"
                           Height="1"
                           Fill="#1A000000"
                           Margin="0 8 0 0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0 8 0 0">
                <Button x:Name="SpeakButton"
                        Style="{StaticResource PopupActionButton}"
                        Padding="12 5"
                        Margin="8 0 0 0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE767;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0 1 5 0"/>
                        <TextBlock Text="朗读" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton"
                        Content="复制"
                        Style="{StaticResource PopupActionButton}"
                        Padding="12 5"
                        Margin="8 0 0 0"/>
                <Button x:Name="DismissButton"
                        Content="关闭"
                        Style="{StaticResource PopupDismissButton}"
                        Padding="12 5"
                        Margin="8 0 0 0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
