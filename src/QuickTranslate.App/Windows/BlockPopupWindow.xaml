<Window x:Class="QuickTranslate.App.Windows.BlockPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Title="QuickTranslate Block Popup"
        Width="340"
        MinHeight="110"
        MaxHeight="600"
        Left="0"
        Top="0">
    <!-- 自包含按钮样式：测试会脱离 App 资源直接实例化本窗口 -->
    <Window.Resources>
        <ResourceDictionary Source="/QuickTranslate.App;component/Themes/Generic.xaml"/>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="#F8FFFFFF"
            BorderBrush="#1A000000"
            BorderThickness="1"
            CornerRadius="12"
            Padding="11"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True"
            TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="3"
                              Opacity="0.18"
                              Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0 0 0 8">
                <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                    <!-- 灰色小胶囊标签：macOS 风格的模式指示 -->
                    <Border Background="#0F000000" CornerRadius="8" Padding="8 2">
                        <TextBlock x:Name="BlockHeader"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#8E8E93"
                                   Text="块模式"/>
                    </Border>
                </StackPanel>

                <!-- OCR 原文预览（灰字小号，最多 3 行，超出省略）：让用户核对识别范围 -->
                <TextBlock x:Name="SourceText"
                           FontSize="11.5"
                           Foreground="#8E8E93"
                           TextWrapping="Wrap"
                           MaxHeight="54"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>

                <!-- 原文预览与译文之间的细分隔线：仅在原文可见时显示，结构更清晰 -->
                <Rectangle x:Name="SourceDivider"
                           Height="1"
                           Fill="#0F000000"
                           Margin="0 8 0 0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          x:Name="ScrollViewer1"
                          MaxHeight="460"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TranslationText"
                           FontSize="14"
                           Foreground="#1C1C1E"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           Text=""/>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0 8 0 0">
                <Button x:Name="SpeakButton"
                        Style="{StaticResource PopupActionButton}"
                        Padding="12 5"
                        Margin="8 0 0 0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <!-- Segoe Fluent Icons 音量图标（单色线性，与全局极简风格一致，替代 emoji） -->
                        <TextBlock Text="&#xE767;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0 1 5 0"/>
                        <TextBlock Text="朗读" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton"
                        Content="复制"
                        Style="{StaticResource PopupActionButton}"
                        Padding="12 5"
                        Margin="8 0 0 0"/>
                <Button x:Name="DismissButton"
                        Content="关闭"
                        Style="{StaticResource PopupDismissButton}"
                        Padding="12 5"
                        Margin="8 0 0 0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
