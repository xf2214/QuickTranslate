<Window x:Class="QuickTranslate.App.Windows.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Title="QuickTranslate Overlay"
        Left="0"
        Top="0"
        Width="1"
        Height="1">
    <Grid>
        <!-- 扫描式选定提示（默认）：苹果风格——轻蓝底色 + 柔光扫描线从左到右单次扫过，不画边框 -->
        <Grid x:Name="ScanPanel"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Rectangle Fill="#14007AFF"
                       RadiusX="4"
                       RadiusY="4"
                       SnapsToDevicePixels="True"/>
            <Border CornerRadius="4" ClipToBounds="True">
                <Rectangle x:Name="ScanLine" Width="36" HorizontalAlignment="Left">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#00007AFF" Offset="0"/>
                            <GradientStop Color="#40007AFF" Offset="0.4"/>
                            <GradientStop Color="#A6007AFF" Offset="0.5"/>
                            <GradientStop Color="#40007AFF" Offset="0.6"/>
                            <GradientStop Color="#00007AFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="ScanTranslate"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>
        </Grid>
        <!-- 实线选定框（仅调试模式显示）：Apple 蓝描边 + 轻蓝填充，圆角 4 -->
        <Border x:Name="SelectionBorder"
                BorderBrush="#FF007AFF"
                BorderThickness="2"
                Background="#1A007AFF"
                CornerRadius="4"
                SnapsToDevicePixels="True"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
        <!-- 虚线预览框（截图范围）：系统灰，代码后置切换可见性 -->
        <Rectangle x:Name="PreviewBorder"
                   Stroke="#CC8E8E93"
                   StrokeThickness="2"
                   StrokeDashArray="4 3"
                   Fill="#0F8E8E93"
                   RadiusX="4"
                   RadiusY="4"
                   SnapsToDevicePixels="True"
                   Visibility="Collapsed"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>
    </Grid>
</Window>
