<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:QuickTranslate.App.Windows.Controls"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ProbeStatus -> 外边框刷 -->
    <SolidColorBrush x:Key="HotkeyBorderUnknown" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="HotkeyBorderAvailable" Color="#16A34A"/>
    <SolidColorBrush x:Key="HotkeyBorderSelfConflict" Color="#D97706"/>
    <SolidColorBrush x:Key="HotkeyBorderExternalConflict" Color="#DC2626"/>
    <SolidColorBrush x:Key="HotkeyBorderInvalid" Color="#EF4444"/>

    <!-- ProbeStatus -> 背景刷 -->
    <SolidColorBrush x:Key="HotkeyBgUnknown" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HotkeyBgAvailable" Color="#F0FDF4"/>
    <SolidColorBrush x:Key="HotkeyBgSelfConflict" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="HotkeyBgExternalConflict" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="HotkeyBgInvalid" Color="#FEF2F2"/>

    <!-- ProbeStatus -> 徽章前景 -->
    <SolidColorBrush x:Key="HotkeyBadgeUnknown" Color="#6B7280"/>
    <SolidColorBrush x:Key="HotkeyBadgeAvailable" Color="#16A34A"/>
    <SolidColorBrush x:Key="HotkeyBadgeSelfConflict" Color="#D97706"/>
    <SolidColorBrush x:Key="HotkeyBadgeExternalConflict" Color="#DC2626"/>
    <SolidColorBrush x:Key="HotkeyBadgeInvalid" Color="#EF4444"/>

    <!-- ==================== Apple 风格共享设计令牌 ==================== -->
    <SolidColorBrush x:Key="AppleAccentBlue" Color="#007AFF"/>
    <SolidColorBrush x:Key="AppleTextPrimary" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="AppleTextSecondary" Color="#8E8E93"/>
    <SolidColorBrush x:Key="AppleCardBackground" Color="#F8FFFFFF"/>
    <SolidColorBrush x:Key="AppleHairline" Color="#1A000000"/>
    <SolidColorBrush x:Key="AppleSuccessGreen" Color="#34C759"/>
    <SolidColorBrush x:Key="AppleDangerRed" Color="#FF3B30"/>

    <!-- 弹窗操作按钮（复制/朗读）：macOS 胶囊按钮，无边框、全圆角、半透明黑底；
         hover/press 背景以 120ms 颜色渐变过渡，避免硬切换 -->
    <Style x:Key="PopupActionButton" TargetType="Button">
        <Setter Property="Background" Value="#0F000000"/>
        <Setter Property="Foreground" Value="#1C1C1E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="13"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="B"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#1A000000" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="B"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#0F000000" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="B"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#26000000" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="B"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#1A000000" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#8E8E93"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标胶囊按钮（简洁模式页脚）：与 PopupActionButton 同模板，固定小尺寸放图标字形 -->
    <Style x:Key="PopupIconActionButton" TargetType="Button" BasedOn="{StaticResource PopupActionButton}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 弹窗关闭按钮：默认同胶囊按钮，悬停转红提示关闭（Apple 红系），120ms 渐变过渡 -->
    <Style x:Key="PopupDismissButton" TargetType="Button" BasedOn="{StaticResource PopupActionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="13"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="B"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#1AFF3B30" Duration="0:0:0.12"/>
                                        <ColorAnimation Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                        To="#FF3B30" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="B"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#0F000000" Duration="0:0:0.12"/>
                                        <ColorAnimation Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                        To="#1C1C1E" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#33FF3B30"/>
                            <Setter Property="Foreground" Value="#FF3B30"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:HotkeyRecorder}">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, PingFang SC, sans-serif"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HotkeyRecorder}">
                    <Border x:Name="OuterBorder"
                            CornerRadius="6"
                            BorderThickness="1.2"
                            Background="{StaticResource HotkeyBgUnknown}"
                            BorderBrush="{StaticResource HotkeyBorderUnknown}"
                            Padding="6 4">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ProbeStates">
                                <VisualState x:Name="Unknown">
                                    <Storyboard>
                                        <ColorAnimation To="#9CA3AF" Duration="0:0:0.15"
                                            Storyboard.TargetName="OuterBorder"
                                            Storyboard.TargetProperty="BorderBrush.Color"/>
                                        <ColorAnimation To="#FFFFFF" Duration="0:0:0.15"
                                            Storyboard.TargetName="OuterBorder"
                                            Storyboard.TargetProperty="Background.Color"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Available">
                                    <Storyboard>
                                        <ColorAnimation To="#16A34A" Duration="0:0:0.15"
                                            Storyboard.TargetName="OuterBorder"
                                            Storyboard.TargetProperty="BorderBrush.Color"/>
                                        <ColorAnimation To="#F0FDF4" Duration="0:0:0.15"
                                            Storyboard.TargetName="OuterBorder"
                                            Storyboard.TargetProperty="Background.Color"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelfConflict">
                                    <Storyboard>
                                        <ColorAnimation To="#D97706" Duration="0:0:0.15"
                                            Storyboard.TargetName="OuterBorder"
                                            Storyboard.TargetProperty="BorderBrush.Color"/>
                                        <ColorAnimation To="#FFFBEB" Duration="0:0:0.15"
                                            Storyboard.TargetName="OuterBorder"
                                            Storyboard.TargetProperty="Background.Color"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ExternalConflict">
                                    <Storyboard>
                                        <ColorAnimation To="#DC2626" Duration="0:0:0.15"
                                            Storyboard.TargetName="OuterBorder"
                                            Storyboard.TargetProperty="BorderBrush.Color"/>
                                        <ColorAnimation To="#FEF2F2" Duration="0:0:0.15"
                                            Storyboard.TargetName="OuterBorder"
                                            Storyboard.TargetProperty="Background.Color"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Invalid">
                                    <Storyboard>
                                        <ColorAnimation To="#EF4444" Duration="0:0:0.15"
                                            Storyboard.TargetName="OuterBorder"
                                            Storyboard.TargetProperty="BorderBrush.Color"/>
                                        <ColorAnimation To="#FEF2F2" Duration="0:0:0.15"
                                            Storyboard.TargetName="OuterBorder"
                                            Storyboard.TargetProperty="Background.Color"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 热键输入文本 -->
                            <TextBox x:Name="PART_TextBox"
                                     Grid.Column="0"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Padding="6 2"
                                     Margin="0 0 8 0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}"
                                     Foreground="#111827"
                                     CaretBrush="#111827"/>

                            <!-- 状态徽章 -->
                            <Border x:Name="PART_StatusBadge"
                                    Grid.Column="1"
                                    CornerRadius="10"
                                    Padding="8 2"
                                    Margin="0 0 8 0"
                                    Background="{StaticResource HotkeyBadgeUnknown}"
                                    Opacity="0.10"
                                    VerticalAlignment="Center"
                                    MinWidth="52">
                                <TextBlock x:Name="PART_StatusText"
                                           Foreground="#111827"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding StatusMessage}"/>
                            </Border>

                            <!-- 录制按钮 -->
                            <Button x:Name="PART_RecordButton"
                                    Grid.Column="2"
                                    Content="录制"
                                    Padding="12 4"
                                    Margin="0 0 6 0"
                                    FontSize="12"
                                    Background="#EFF6FF"
                                    Foreground="#1D4ED8"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Btn" CornerRadius="5"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Btn" Property="Background" Value="#DBEAFE"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Btn" Property="Background" Value="#BFDBFE"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 清除按钮 -->
                            <Button x:Name="PART_ClearButton"
                                    Grid.Column="3"
                                    Content="×"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Padding="10 0"
                                    Height="24"
                                    Background="#F9FAFB"
                                    Foreground="#6B7280"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Btn2" CornerRadius="5"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Btn2" Property="Background" Value="#FEF2F2"/>
                                                            <Setter TargetName="Btn2" Property="BorderBrush" Value="#FECACA"/>
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ProbeStatus -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="ProbeStatus" Value="Available">
                            <Setter Property="Background" TargetName="PART_StatusBadge" Value="{StaticResource HotkeyBgAvailable}"/>
                            <Setter Property="TextElement.Foreground" TargetName="PART_StatusText" Value="{StaticResource HotkeyBadgeAvailable}"/>
                            <Setter Property="Opacity" TargetName="PART_StatusBadge" Value="1"/>
                        </Trigger>
                        <Trigger Property="ProbeStatus" Value="SelfConflict">
                            <Setter Property="Background" TargetName="PART_StatusBadge" Value="{StaticResource HotkeyBgSelfConflict}"/>
                            <Setter Property="TextElement.Foreground" TargetName="PART_StatusText" Value="{StaticResource HotkeyBadgeSelfConflict}"/>
                            <Setter Property="Opacity" TargetName="PART_StatusBadge" Value="1"/>
                        </Trigger>
                        <Trigger Property="ProbeStatus" Value="ExternalConflict">
                            <Setter Property="Background" TargetName="PART_StatusBadge" Value="{StaticResource HotkeyBgExternalConflict}"/>
                            <Setter Property="TextElement.Foreground" TargetName="PART_StatusText" Value="{StaticResource HotkeyBadgeExternalConflict}"/>
                            <Setter Property="Opacity" TargetName="PART_StatusBadge" Value="1"/>
                        </Trigger>
                        <Trigger Property="ProbeStatus" Value="Invalid">
                            <Setter Property="Background" TargetName="PART_StatusBadge" Value="{StaticResource HotkeyBgInvalid}"/>
                            <Setter Property="TextElement.Foreground" TargetName="PART_StatusText" Value="{StaticResource HotkeyBadgeInvalid}"/>
                            <Setter Property="Opacity" TargetName="PART_StatusBadge" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
