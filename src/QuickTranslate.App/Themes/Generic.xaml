<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:QuickTranslate.App.Windows.Controls">

    <Style TargetType="{x:Type controls:HotkeyRecorder}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HotkeyRecorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PART_TextBox"
                                 Grid.Column="0"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Padding="6 2"
                                 Margin="0 0 4 0"/>
                        <Button x:Name="PART_RecordButton"
                                Grid.Column="1"
                                Content="录制"
                                Padding="8 2"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
